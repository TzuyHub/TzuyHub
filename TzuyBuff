using UnityEngine;

// TzuyBuff - demo client-side buff system for your own project.
// For educational/single-player use only. Do NOT use to cheat in other people's games.
[RequireComponent(typeof(CharacterController))]
public class TzuyBuff : MonoBehaviour
{
    [Header("Base Movement")]
    public float baseSpeed = 6f;
    public float baseJumpForce = 5f;
    public float gravity = -9.81f;

    [Header("Buffs")]
    public bool buffRunFast = false;
    public float runMultiplier = 2f;

    public bool buffHighJump = false;
    public float highJumpMultiplier = 1.8f;

    public bool buffInfiniteJump = false;

    public bool buffFly = false;
    public float flySpeed = 6f;

    CharacterController cc;
    Vector3 velocity;
    bool canJump = true; // used when not infinite jump

    void Start()
    {
        cc = GetComponent<CharacterController>();
    }

    void Update()
    {
        HandleMovement();
    }

    void HandleMovement()
    {
        float speed = baseSpeed * (buffRunFast ? runMultiplier : 1f);
        float moveX = Input.GetAxis("Horizontal");
        float moveZ = Input.GetAxis("Vertical");

        Vector3 move = transform.right * moveX + transform.forward * moveZ;
        if (buffFly)
        {
            // Fly mode: no gravity, vertical control with Jump / Crouch (or keys)
            float upDown = 0f;
            if (Input.GetButton("Jump")) upDown += 1f;
            if (Input.GetKey(KeyCode.LeftControl) || Input.GetKey(KeyCode.C)) upDown -= 1f;
            Vector3 flyVel = new Vector3(move.x, upDown, move.z).normalized * flySpeed;
            cc.Move(flyVel * Time.deltaTime);
            // Reset velocity used for grounded physics
            velocity = Vector3.zero;
            canJump = true;
            return;
        }

        // Grounded check
        bool grounded = cc.isGrounded;
        if (grounded && velocity.y < 0f)
        {
            velocity.y = -2f; // small downforce to keep grounded
            canJump = true;
        }

        cc.Move(move * speed * Time.deltaTime);

        // Jump handling
        if (Input.GetButtonDown("Jump"))
        {
            if (grounded || buffInfiniteJump || canJump)
            {
                float jumpForce = baseJumpForce * (buffHighJump ? highJumpMultiplier : 1f);
                velocity.y = Mathf.Sqrt(jumpForce * -2f * gravity);
                if (!buffInfiniteJump) canJump = false;
            }
        }

        // Apply gravity
        velocity.y += gravity * Time.deltaTime;
        cc.Move(velocity * Time.deltaTime);
    }
}
